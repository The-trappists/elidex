# Copy to .env (never committed) and fill in.
# Without LLM_API_KEY, the pipeline replays cached extractions from data/cache/ and the
# workbench runs in "scripted" mode (scenario ground truth). Check providers with `uv run ctx llm-check`.

# ---------------------------------------------------------------- LLM (any OpenAI-compatible endpoint)
# Primary: Google Gemini via AI Studio (free tier; MLH gives students extra credits).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
# gemini-2.5-flash is deprecated (routed elsewhere from 2026-12-01). Check current names in AI Studio.
LLM_MODEL=gemini-3.8-flash
# How to ask for JSON: json_object | json_schema | prompt. `ctx llm-check` tells you which one works.
LLM_JSON_MODE=json_object
LLM_TIMEOUT=60
# Gemini thinks by default, which is slow. "low" is the default for Gemini; use minimal/medium/high, or "off" to send nothing.
# LLM_REASONING_EFFORT=low

# Optional fallback, used when the primary fails (429, 5xx, timeout).
# Featherless (Since AI credit; make sure it lands on a pay-as-you-go balance, the "Chat" plan forbids API use):
# LLM_FALLBACK_BASE_URL=https://api.featherless.ai/v1
# LLM_FALLBACK_API_KEY=your-key-here
# LLM_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct
# LLM_FALLBACK_JSON_MODE=json_object
#
# Snowflake Cortex (MLH 120-day trial; programmatic access token; json_schema only):
# LLM_FALLBACK_BASE_URL=https://<account-identifier>.snowflakecomputing.com/api/v2/cortex/v1
# LLM_FALLBACK_API_KEY=your-pat-here
# LLM_FALLBACK_MODEL=claude-sonnet-4-6
# LLM_FALLBACK_JSON_MODE=json_schema

# ---------------------------------------------------------------- core pipeline
# Elisa's chat and email carry no date: this one is our assumption.
DEFAULT_THREAD_DATE=2026-10-15
DEFAULT_EMAIL_TIME=10:30

# Extracted items below this confidence are not stored (precision first).
MIN_CONFIDENCE=0.5

# ---------------------------------------------------------------- critic role (loop v2, optional)
# A second model that double-checks extracted items (over-wide scope, vague words, unsupported actions).
# Use a different model family from the extractor. Unset: the critic silently uses the primary provider.
# LLM_CRITIC_BASE_URL=https://api.mistral.ai/v1
# LLM_CRITIC_API_KEY=your-key-here
# LLM_CRITIC_MODEL=mistral-large-latest
# LLM_CRITIC_JSON_MODE=json_object
# LLM_CRITIC_REASONING_EFFORT=off
# Optional critic fallback (429, 5xx, timeout):
# LLM_CRITIC_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# LLM_CRITIC_FALLBACK_API_KEY=your-key-here
# LLM_CRITIC_FALLBACK_MODEL=llama-3.3-70b-versatile
# LLM_CRITIC_FALLBACK_JSON_MODE=json_object

# ---------------------------------------------------------------- knowledge graph (optional Neo4j mirror)
# `docker compose -f deploy/docker-compose.neo4j.yml up -d`, then `uv run ctx graph push`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
# NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------- workbench (`uv run ctx workbench`)
# WORKBENCH_STATE_FILE=out/workbench/state.json
WORKBENCH_SIM_START=2026-10-20T07:30
# Wall seconds without a new message before a thread goes through the pipeline.
WORKBENCH_IDLE_SECONDS=8

# Slack bridge (optional, Socket Mode: no public URL needed). See docs/slack-setup.md.
SLACK_BOT_TOKEN=your-xoxb-token
SLACK_APP_TOKEN=your-xapp-token
SLACK_CHANNEL_ID=your-channel-id

# ---------------------------------------------------------------- big dataset storage (docs/dataset.md)
# MongoDB Atlas: Database > Connect > Drivers. Replace <password> in the URI; URL-encode special characters.
MONGODB_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ctx
# Tiger Data (PostgreSQL/TimescaleDB): the service connection string.
TIGER_DATABASE_URL=postgresql://your-user:your-password@your-host:5432/tsdb?sslmode=require
# Embedding model for the vector search (same provider as LLM_*). Leave empty for the offline hashed-words fallback.
EMBEDDING_MODEL=
# Dataset folder read by `ctx dataset threads` when --source files (default out/dataset/demo).
DATASET_DIR=out/dataset/demo

# ---------------------------------------------------------------- deployment (deploy/, docs/deploy-vultr.md)
# Public host name for Caddy (HTTPS). Without a domain, use <server-ip>.sslip.io
DOMAIN=localhost
# Team login. Make the hash with: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Put the hash in single quotes, e.g. BASIC_AUTH_HASH='$2a$14$...', so compose keeps the $ signs.
BASIC_AUTH_USER=team
BASIC_AUTH_HASH=your-bcrypt-hash
