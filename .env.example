# Copy to .env (never committed) and fill in.
# Without LLM_API_KEY, the pipeline replays cached extractions from data/cache/.

# Any OpenAI-compatible endpoint works. Examples:
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
#   Featherless: https://api.featherless.ai/v1
#   Anthropic:   https://api.anthropic.com/v1/
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
# Check the provider's current model names.
LLM_MODEL=gemini-2.5-flash

# Elisa's chat and email carry no date: this one is our assumption.
DEFAULT_THREAD_DATE=2026-10-15
DEFAULT_EMAIL_TIME=10:30

# Extracted items below this confidence are not stored (precision first).
MIN_CONFIDENCE=0.5
